<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SYSTEMES.WindowsHost</AssemblyName>
    <RootNamespace>SYSTEMES.WindowsHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../dist/index.html')">
    <Content Include="../../dist/**/*">
      <Link>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="PublishNativeEngine" AfterTargets="Build">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Windver/Core/SystemesNative.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(TargetDir)native-engine&quot;" />
  </Target>
  <Target Name="PublishNativeEngineForPublish" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Windver/Core/SystemesNative.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(PublishDir)native-engine&quot;" />
  </Target>
</Project>
